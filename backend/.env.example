# Copy this file to backend/.env and fill in your local values
DB_NAME=osha_benchmark
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Contact form (docs/decisions.md, D-010) ---

# Cloudflare Turnstile secret key. Leave empty in development to use Cloudflare's test secret.
TURNSTILE_SECRET_KEY=

# Where verified messages are sent
CONTACT_RECIPIENT_EMAIL=

# SMTP provider (Resend or Brevo). Leave EMAIL_HOST empty in development: emails are then
# printed in the Django terminal instead of being sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The sender address, on a domain the provider has verified
DEFAULT_FROM_EMAIL=
